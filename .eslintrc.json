{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true,
    "serviceworker": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "no-undef": "warn",
    "prefer-const": "warn",
    "no-var": "error",
    "eqeqeq": "warn"
  },
  "ignorePatterns": [
    "dist/",
    "node_modules/",
    "*.config.js",
    "webpack.*.js"
  ]
}
